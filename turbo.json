{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "DATABASE_DIRECT_URL", "TEST_DATABASE_URL", "APP_DOMAIN", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "NODE_ENV", "WORKER_PORT", "NEXT_PUBLIC_WORKER_URL", "WORKER_ALLOW_ORIGIN", "TENANT_CHECK_CRON", "WEBHOOK_TEST_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {}
  }
}
