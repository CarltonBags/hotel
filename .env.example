# Copy to .env (never committed). Local development defaults.
DATABASE_URL=postgres://localhost:5432/hoteloftware_dev
# Direct (non-pooled) connection for migrations, provisioning and the worker. On Neon: the endpoint without "-pooler".
DATABASE_DIRECT_URL=postgres://localhost:5432/hoteloftware_dev
TEST_DATABASE_URL=postgres://localhost:5432/hoteloftware_test
# Staff app is served at <tenant>.<APP_DOMAIN>. Chrome resolves *.localhost to 127.0.0.1.
APP_DOMAIN=localhost:3000
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please-really
BETTER_AUTH_URL=http://localhost:3000
# Next.js reads .env only from the app directory: apps/staff/.env and apps/guest/.env are symlinks to this file.
# Worker (apps/worker): HTTP port, public URL the browser opens the live-update stream at,
# cron for the demo tenant check (unset = off), shared secret for the "test" webhook source.
WORKER_PORT=8080
NEXT_PUBLIC_WORKER_URL=http://localhost:8080
WORKER_ALLOW_ORIGIN=*
TENANT_CHECK_CRON=* * * * *
WEBHOOK_TEST_SECRET=local-test-webhook-secret
