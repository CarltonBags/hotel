<!-- Ticino cantonal police, "Notifiche di Polizia": import schema F-Modello_4.xsd, as published at
     https://www4.ti.ch/fileadmin/DI/POLIZIA/documentazione/autorizzazioni/notifiche/F-Modello_4.xsd (read 2026-10-05).
     Kept here to validate our export (ticket 47); re-check against the published file when it changes. -->
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name = "registrationForms">
		<xs:complexType>
			<xs:sequence>
				<xs:element name = "registration">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="userId" type="xs:string" />
							<xs:element name="firstname" type="xs:string" />
							<xs:element name="lastname" type="xs:string" />
							<xs:element name="birthdate" type="xs:date" />
							<xs:element name="nationality">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[A-Z][A-Z][A-Z]"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="arrivaldate" type="xs:date" />
							<xs:element name="placeofbirth" type="xs:string" />
							<xs:element name="street" type="xs:string" />
							<xs:element name="zip" type="xs:integer" />
							<xs:element name="city" type="xs:string" />
							<xs:element name="nation">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[A-Z][A-Z][A-Z]"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="departuredate" type="xs:date" />
							<xs:element name="persover14" type="xs:integer" />
							<xs:element name="persunder14" type="xs:integer" />
							<xs:element name="documentType">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="Passport"/>
										<xs:enumeration value="Identity card"/>
										<xs:enumeration value="Other"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="documentNumber" type="xs:string" />
							<xs:element name="carid" type="xs:string" />
							<xs:element name="referenceNr" type="xs:string" />
						</xs:sequence>
				</xs:complexType>
				</xs:element>
			 </xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
